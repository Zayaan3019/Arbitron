# URL of the deployed Render backend (no trailing slash).
# Leave empty in local dev — the Vite proxy forwards /api and /ws to localhost:8000.
VITE_API_URL=https://arbitron-api.onrender.com

# Shared secret matching ARBITRON_API_KEY on the backend.
# Required whenever the backend runs with ARBITRON_REQUIRE_API_KEY=true.
#
# NOTE: this value is compiled into the browser bundle and is readable by
# anyone who opens it. It is a spend guard against drive-by traffic on a
# public demo, NOT user authentication. Do not reuse a secret that protects
# anything else, and rotate it if the deployment gets attention.
VITE_API_KEY=
