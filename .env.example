# Copy to .env and fill in. Only GROQ_API_KEY is needed for local use.

# LLM agent (free key: https://console.groq.com). Factors, backtests, lab and risk work without it.
GROQ_API_KEY=

# --- API security (set both for any public deployment) ---
# Comma-separated shared secrets accepted in the X-API-Key header.
ARBITRON_API_KEY=
# true: requests without a valid key are rejected; with no key configured, every request gets 503.
ARBITRON_REQUIRE_API_KEY=false
# Allowed frontend origin(s), comma-separated. Empty = local dev origins (localhost:5173/3000).
ARBITRON_CORS_ORIGIN=
# Agent/lab runs allowed per minute per client IP.
ARBITRON_RATE_LIMIT_PER_MIN=10

# --- Runtime ---
ARBITRON_CACHE_DIR=.cache/arbitron
ARBITRON_AGENT_TIMEOUT=900
ARBITRON_MAX_SESSIONS=64
ARBITRON_SESSION_TTL=1800
ARBITRON_LOG_LEVEL=INFO
# Optional file that persists the trial registry across restarts.
ARBITRON_TRIAL_LOG=
